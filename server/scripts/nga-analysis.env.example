# =====================================================================
# NGA 舆情分析脚本环境变量
# 位置：/etc/nga-analysis/.env    权限：600 root:root
# 由 server/scripts/nga_analysis.py 通过 python-dotenv 加载
#
# ★ 这里只剩「数据库连接」——因为面板要读 system_settings 才能拿到配置，
#   这一步无法避免。其余全部配置（开关 / 频率 / 版面 / 帖数 / API Key /
#   Cookie / 模型 / 超时）都已搬到控制面板：
#       系统控制面板 → 市场情绪（+ 运行状态）
#   改配置请去面板，不要改这个文件。
#
#   已迁走、不再被脚本读取的历史项（保留在此仅供备份，改它们不会生效）：
#     GEMINI_API_KEY / NGA_COOKIE_FILE   → 面板「市场情绪」
# =====================================================================

# ---------------- 数据库（与后端 server/.env 一致） ----------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=teyvat
DB_PASS=__DB_PASSWORD__
DB_NAME=teyvat_stock

# ---------------- 可选的运行时覆盖（一般不用改） ----------------
# 内存/CPU 硬上限；实测真实负载峰值 22.9MB，64MB 有 2.5 倍余量
# NGA_RLIMIT_AS_MB=64
# NGA_RLIMIT_CPU_S=60
# 指定另一个 env 文件路径
# NGA_ENV_FILE=/etc/nga-analysis/.env
