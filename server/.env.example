# ============ 提瓦特证券交易所 后端环境变量示例 ============
# 复制为 .env 后按需修改：cp .env.example .env

NODE_ENV=development
PORT=3000

# ---- MySQL 8.0 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=teyvat_stock
DB_POOL_MAX=5          # 1G 内存建议 ≤ 5
DB_POOL_MIN=0
DB_CONNECTION_LIMIT=10

# ---- JWT ----
JWT_SECRET=please_change_me_to_a_long_random_string
JWT_EXPIRES=7d

# ---- 业务参数 ----
# ⚠️ 注意：以下参数（CYCLE_MINUTES / DAILY_CLOSE_HOUR / START_MORA / 波动率 / 限幅 /
#    NEWS_TTL_CYCLES）现在都可以在「超级管理员 → 系统控制面板 → 系统开关与参数」
#    里在线调整，数据库中的值优先于这里的 .env 值。.env 只作为「首次部署的初始值/兜底」。
#
# 每周期撮合/估价间隔（分钟），默认 10。可在面板改（改后 K 线档位随之变化）
CYCLE_MINUTES=10
# 每日收盘生成日K的时间（服务器本地时区小时），默认 15
DAILY_CLOSE_HOUR=15
# 新用户赠送摩拉
START_MORA=1000000

# 涨跌幅 = (压力因子×A + 新闻因子×B + 投票因子×C) × 基础波动率，最终限幅 ±MAX_CHANGE
WEIGHT_PRESSURE=0.5
WEIGHT_NEWS=0.3
WEIGHT_VOTE=0.2
BASE_VOLATILITY=0.02    # 基础波动率（每周期）
MAX_CHANGE=0.10         # 单周期最大涨跌幅 ±10%

# 压力因子敏感度：净买量/流通股比例 × 该系数，再限幅 [-1,1]
PRESSURE_GAIN=200
# 新闻生效周期数（发布后 N 个周期内计入股价引擎）
NEWS_TTL_CYCLES=6
# 新闻投票倍率范围
VOTE_MULT_MIN=0.5
VOTE_MULT_MAX=2.0
# 单笔买卖最小/最大股数校验
ORDER_MIN_QTY=1
ORDER_MAX_QTY=1000000

# ==================== 注册限制（一设备一账号） ====================
# 必须带设备号（前端自动带 X-Device-Id 头），关闭则允许无设备号注册
REGISTER_REQUIRE_DEVICE_ID=1
# 没带设备号时用 IP+UA 哈希兜底（脚本/curl 也拦得住）；副作用：同IP同浏览器只能注册1个
REGISTER_DEVICE_AUTO_FALLBACK=1
# 同一 IP 每 24 小时最多注册几个账号（0=不限制），防「清缓存刷号」
REGISTER_MAX_PER_IP_PER_DAY=3

# ==================== 高频操作限流（令牌桶，内存实现） ====================
# 总开关；各值 = 该窗口内允许次数，填 0 可单独关闭某项
RATE_LIMIT_ENABLED=1
RATE_API_PER_MIN=600          # 全站每 IP 每分钟
RATE_WRITE_PER_MIN=120        # 写操作（非 GET）每人/每IP 每分钟
RATE_LOGIN_PER_5MIN=10        # 登录：每 IP+用户名 / 5 分钟
RATE_REGISTER_PER_HOUR=5      # 注册：每 IP / 小时
RATE_ORDER_PER_MIN=30         # 下单：每人每分钟
RATE_CANCEL_PER_MIN=60        # 撤单：每人每分钟
RATE_VOTE_PER_MIN=60          # 投票：每人每分钟
RATE_NEWS_PER_HOUR=20         # 发布/编辑新闻：每人每小时
RATE_ADMIN_PER_MIN=60         # 管理端写操作：每人每分钟

# 种子账号（npm run seed 时创建，勿在生产使用默认值）
SEED_ROOT_USER=root
SEED_ROOT_PASS=Root123!
SEED_ADMIN_USER=admin
SEED_ADMIN_PASS=Admin123!
SEED_OPERATOR_USER=operator
SEED_OPERATOR_PASS=Op123456
SEED_USER_USER=demo
SEED_USER_PASS=Demo123456
